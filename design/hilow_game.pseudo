# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#

    START
    SET play_again = "yes"

    WHILE play_again == "yes" DO
        SET secret_number = RANDOM_INTEGER(1, 10)
        SET guess = 0
        SET is_correct = FALSE

        PRINT "I'm thinking of a number between 1 and 10. Can you guess it?"

        WHILE is_correct == FALSE DO
            PRINT "Enter your guess:"
            READ guess

            IF guess < 1 OR guess > 10 THEN
                PRINT "Please pick a number between 1 and 10."
            ELSE IF guess < secret_number THEN
                PRINT "Higher! Try again."
            ELSE IF guess > secret_number THEN
                PRINT "Lower! Try again."
            ELSE
                PRINT "You got it! Great job!"
                SET is_correct = TRUE
            END IF
        END WHILE

        PRINT "Do you want to play again? (yes/no)"
        READ play_again
    END WHILE

    PRINT "Thanks for playing!"
END
